- name: samp_rate
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: samp_rate
    short_id: s
    type: eng_float
    value: 0.2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [504, 11]
    rotation: 0
