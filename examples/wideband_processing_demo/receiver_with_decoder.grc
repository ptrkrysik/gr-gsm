    alias: ''
    comment: ''
    hide: none
    label: fc
    short_id: p
    type: eng_float
    value: 939.4e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [272, 11]
    rotation: 0
    state: enabled
- name: gsm_bcch_ccch_demapper_0
