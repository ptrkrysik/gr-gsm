options:
  parameters:
    author: Piotr Krysik
    catch_exceptions: 'True'
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Demonstration of uplink decoding using data captured with use of
      Multi-rtl
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: uplink_decoding_multi_rtl
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Uplink decoding demo
    window_size: 2280, 1024
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [5, 4]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [192, 5]
    rotation: 0
    state: enabled
- name: blocks_file_source_0
  id: blocks_file_source
  parameters:
    affinity: ''
    alias: ''
    begin_tag: pmt.PMT_NIL
    comment: ''
    file: sms_multirtl_downlink_tail.cfile
    length: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    repeat: 'False'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [0, 157]
    rotation: 0
    state: enabled
- name: blocks_file_source_0_0
  id: blocks_file_source
  parameters:
    affinity: ''
    alias: ''
    begin_tag: pmt.PMT_NIL
    comment: ''
    file: sms_multirtl_uplink_tail.cfile
    length: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    repeat: 'False'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [0, 229]
    rotation: 0
    state: enabled
- name: blocks_socket_pdu_0_0_0
  id: network_socket_pdu
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    host: 127.0.0.1
    maxoutbuf: '0'
    minoutbuf: '0'
    mtu: '10000'
    port: '4729'
    tcp_no_delay: 'False'
    type: UDP_CLIENT
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1416, 167]
    rotation: 0
    state: enabled
- name: gsm_clock_offset_control_0
  id: gsm_clock_offset_control
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    fc: 947.8e6
    maxoutbuf: '0'
    minoutbuf: '0'
    osr: osr
    samp_rate: samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 324]
    rotation: 180
    state: enabled
- name: gsm_control_channels_decoder_0_1
  id: gsm_control_channels_decoder
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1112, 169]
    rotation: 0
    state: enabled
- name: gsm_control_channels_decoder_0_1_0
  id: gsm_control_channels_decoder
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1112, 233]
    rotation: 0
    state: enabled
- name: gsm_decryption_0_3
  id: gsm_decryption
  parameters:
    a5_version: '1'
    affinity: ''
    alias: ''
    comment: ''
    k_c: '[0x46,0x77,0x2d,0x54,0xa3,0xa3,0xc3,0x1c]'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [872, 221]
    rotation: 0
    state: enabled
- name: gsm_input_0
  id: gsm_input
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    fc: 947.8e6
    maxoutbuf: '0'
    minoutbuf: '0'
    osr: '4'
    ppm: '0'
    samp_rate_in: samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [224, 169]
    rotation: 0
    state: enabled
- name: gsm_input_0_0
  id: gsm_input
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    fc: 947.8e6-45e6
    maxoutbuf: '0'
    minoutbuf: '0'
    osr: '4'
    ppm: '0'
    samp_rate_in: samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [224, 241]
    rotation: 0
    state: enabled
- name: gsm_message_printer_0_0
  id: gsm_message_printer
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    prepend_fnr: 'False'
    prepend_frame_count: 'False'
    prepend_string: '""'
    print_gsmtap_header: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1416, 294]
    rotation: 0
    state: enabled
- name: gsm_receiver_with_uplink_0
  id: gsm_receiver_with_uplink
  parameters:
    affinity: ''
    alias: ''
    cell_allocation: '[22]'
    comment: 'arfcn: 22

      Training Sequence: 2'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_streams: '1'
    osr: '4'
    tseq_nums: '[2]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [432, 169]
    rotation: 0
    state: enabled
- name: gsm_sdcch8_demapper_0
  id: gsm_sdcch8_demapper
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    timeslot_nr: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [672, 164]
    rotation: 0
    state: enabled
- name: osr
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: OSR
    short_id: ''
    type: intx
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 7]
    rotation: 0
    state: enabled
- name: socket_pdu_server
  id: network_socket_pdu
  parameters:
    affinity: ''
    alias: ''
    comment: added in order to avoid generating ICMP messages
    host: 127.0.0.1
    maxoutbuf: '0'
    minoutbuf: '0'
    mtu: '10000'
    port: '4729'
    tcp_no_delay: 'False'
    type: UDP_SERVER
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1552, 164]
    rotation: 0
    state: enabled

connections:
- [blocks_file_source_0, '0', gsm_input_0, '0']
- [blocks_file_source_0_0, '0', gsm_input_0_0, '0']
- [gsm_clock_offset_control_0, ctrl, gsm_input_0, ctrl_in]
- [gsm_clock_offset_control_0, ctrl, gsm_input_0_0, ctrl_in]
- [gsm_control_channels_decoder_0_1, msgs, blocks_socket_pdu_0_0_0, pdus]
- [gsm_control_channels_decoder_0_1, msgs, gsm_message_printer_0_0, msgs]
- [gsm_control_channels_decoder_0_1_0, msgs, blocks_socket_pdu_0_0_0, pdus]
- [gsm_control_channels_decoder_0_1_0, msgs, gsm_message_printer_0_0, msgs]
- [gsm_decryption_0_3, bursts, gsm_control_channels_decoder_0_1_0, bursts]
- [gsm_input_0, '0', gsm_receiver_with_uplink_0, '0']
- [gsm_input_0_0, '0', gsm_receiver_with_uplink_0, '1']
- [gsm_receiver_with_uplink_0, C0, gsm_sdcch8_demapper_0, bursts]
- [gsm_receiver_with_uplink_0, measurements, gsm_clock_offset_control_0, measurements]
- [gsm_sdcch8_demapper_0, bursts, gsm_control_channels_decoder_0_1, bursts]
- [gsm_sdcch8_demapper_0, bursts, gsm_decryption_0_3, bursts]

metadata:
  file_format: 1
  grc_version: 3.10.9.2
